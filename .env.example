# Postgres (Supabase : réglages du projet → Database → connection string, mode transaction).
# Laisser vide en local : Yoon utilise un fichier PGlite dans data/pglite.
DATABASE_URL=

# Secret de session. À définir en production.
AUTH_SECRET=

# YOON_DB=memory pour une base éphémère (tests).
# YOON_SKIP_ROUTING=1 pour ignorer OSRM et tracer une ligne droite.
