# SENTRAJET PREMIUM — variables d'environnement
# Copier ce fichier en .env.local (développement) ou les saisir dans Vercel (production).
# Aucune valeur secrète ne doit être commitée.

# Base PostgreSQL (Supabase : chaîne « Transaction pooler », port 6543).
# Laisser vide en local : une base PGlite est créée dans .data/pglite avec des données de démonstration.
DATABASE_URL=

# Nombre maximal de connexions par instance serveur (5 par défaut).
DB_POOL_MAX=5

# URL publique du site (SEO, liens dans les e-mails et PDF).
NEXT_PUBLIC_SITE_URL=https://sen-trajet-vtc.vercel.app

# Super administrateur créé au premier `npm run db:migrate` / déploiement s'il n'existe pas.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# E-mails transactionnels via Resend. Sans clé, les e-mails restent en file
# (Back-office > Paramètres > Boîte d'envoi) sans être envoyés.
RESEND_API_KEY=
EMAIL_FROM=SENTRAJET PREMIUM <reservations@votre-domaine.sn>
ADMIN_NOTIFICATION_EMAIL=

# Local uniquement : dossier PGlite (« memory » pour une base éphémère)
# et chargement des comptes de démonstration (0 pour désactiver).
PGLITE_DIR=.data/pglite
SEED_DEMO=1
